diff -ruN a/templates/controller.yaml b/templates/controller.yaml
--- a/templates/controller.yaml	2026-09-20 12:40:31.492359171 +0200
+++ b/templates/controller.yaml	2026-09-20 13:49:14.826811493 +0200
@@ -12,6 +12,13 @@
       {{- include "truenas-csi.controllerSelectorLabel" . | nindent 6 }}
   template:
     metadata:
+      # VENDORED DEVIATION (not in upstream 1.3.0): the driver reads its URL/portal/pool from this
+      # ConfigMap as environment variables, which are resolved at container start — so a changed
+      # value does NOT roll the pods, and the driver keeps using the old address until someone
+      # notices. That happened: a corrected nvmeofPortal needed a manual `kubectl rollout restart`
+      # before an apply would take. The checksum turns a config change into a rollout.
+      annotations:
+        checksum/config: {{ include (print $.Template.BasePath "/config.yaml") . | sha256sum }}
       labels:
         {{- include "truenas-csi.controllerSelectorLabel" . | nindent 8 }}
         {{- include "truenas-csi.labels" . | nindent 8 }}
diff -ruN a/templates/node.yaml b/templates/node.yaml
--- a/templates/node.yaml	2026-09-20 12:40:31.492411033 +0200
+++ b/templates/node.yaml	2026-09-20 13:49:14.826909696 +0200
@@ -11,6 +11,13 @@
       {{- include "truenas-csi.nodeSelectorLabel" . | nindent 6 }}
   template:
     metadata:
+      # VENDORED DEVIATION (not in upstream 1.3.0): the driver reads its URL/portal/pool from this
+      # ConfigMap as environment variables, which are resolved at container start — so a changed
+      # value does NOT roll the pods, and the driver keeps using the old address until someone
+      # notices. That happened: a corrected nvmeofPortal needed a manual `kubectl rollout restart`
+      # before an apply would take. The checksum turns a config change into a rollout.
+      annotations:
+        checksum/config: {{ include (print $.Template.BasePath "/config.yaml") . | sha256sum }}
       labels:
         {{- include "truenas-csi.nodeSelectorLabel" . | nindent 8 }}
         {{- include "truenas-csi.labels" . | nindent 8 }}
@@ -159,7 +166,18 @@
         - name: iscsi-dir
           hostPath:
             path: /etc/iscsi
-            type: Directory
+            # VENDORED DEVIATION (upstream 1.3.0 has `Directory`). Talos' kubelet runs in a distro image
+            # whose /etc is curated — bound in are only /etc/hosts, /etc/resolv.conf, /etc/kubernetes,
+            # /etc/cni, /etc/nfsmount.conf and /etc/machine-id (read from /proc/<kubelet-pid>/root/etc on a
+            # dev node) — so a strict hostPath of a file the HOST plainly has fails the type check and the
+            # pod can never start. DirectoryOrCreate makes kubelet create the directory in its own view,
+            # which is all that is needed: the volume then resolves against the host's /etc, where the
+            # file already is. Measured: both nodes came up, a PVC bound, the appliance grew a zvol +
+            # subsystem + a live NVMe-oF session, and 64 MiB written through the mount read back with a
+            # matching md5. `machine.kubelet.extraMounts` cannot fix this instead: on Talos v1.14 the
+            # GENERATED config carries a KubeletConfig document, so any .machine.kubelet patch is refused
+            # (`kubelet config is already set in v1alpha1 config`), and that document has no mounts field.
+            type: DirectoryOrCreate
         - name: iscsi-lib
           hostPath:
             path: /var/lib/iscsi
