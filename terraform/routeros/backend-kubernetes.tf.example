# Alternative state backend: a Secret in the devops cluster. Use this when MinIO
# is unavailable, accepting that state is then unreadable while the cluster is
# down (the tradeoff Q8 decided against as a default).
#
# Requires a Role granting the runner's ServiceAccount (namespace `arc-systems`)
# get/list/create/update/delete on secrets in the namespace below.
#
# To switch: replace the `backend` block in backend.tf with this one, then
# `tofu init -migrate-state` (run by CI: tf-apply.yml with workflow_dispatch).
terraform {
  backend "kubernetes" {
    namespace         = "routeros-iac"
    secret_suffix     = "routeros-rb5009"
    in_cluster_config = true
  }
}
