# Template for terraform/secrets/routeros-ci.env — CI credentials for the
# RouterOS IaC track. Dotenv format: scripts/tofu-ci.sh parses KEY=value lines.
#
# Values NEVER go in git, chat or the notes vault. Workflow:
#
#   install -m 600 /dev/null terraform/secrets/routeros-ci.env   # gitignored
#   "$EDITOR" terraform/secrets/routeros-ci.env
#   sops --encrypt --age age1t9wspfgy0nxrc9d3frmp85g4d5ug6ksf66pv68ycptv0fwsxq9fqxuhma9 \
#        --input-type dotenv --output-type dotenv \
#        terraform/secrets/routeros-ci.env > terraform/secrets/enc.routeros-ci.env
#
# Only do this if the credentials cannot be delivered as a cluster Secret
# mounted into the runner pod (path (a) in ../README.md) — that path is
# preferred and needs no age key in the runner.

# RouterOS read identity (`agent-ro`, policy api,read,test — no `sensitive`).
# Used by plan-on-PR and the nightly drift check.
ROS_READ_USERNAME=agent-ro
ROS_READ_PASSWORD=CHANGE_ME_ROUTEROS_AGENT_RO_PASSWORD

# RouterOS write identity (`iac`, policy api,read,write,test).
# Used only by apply-on-merge, behind the `routeros-production` environment gate.
ROS_WRITE_USERNAME=iac
ROS_WRITE_PASSWORD=CHANGE_ME_ROUTEROS_IAC_PASSWORD

# OpenTofu state (MinIO on the devops cluster; Q8). Verified 2026-09-14:
# MinIO healthy (health/cluster 200), S3 API answering, and it advertises
# `x-amz-bucket-region: europe` — sign with that region, not us-east-1.
#
# Endpoint: console-minio.hnatekmar.xyz is the S3 API (the chart's naming is
# inverted; minio.hnatekmar.xyz is the console). Putting an in-cluster service
# here would be better, but minio.minio.svc.cluster.local does not resolve from
# the runner's cluster — see ../README.md, "The state contract".
TF_STATE_BUCKET=tofu-state
TF_STATE_ENDPOINT=https://console-minio.hnatekmar.xyz
TF_STATE_REGION=europe
AWS_ACCESS_KEY_ID=CHANGE_ME_MINIO_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_SECRET_KEY
